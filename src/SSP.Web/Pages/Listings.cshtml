@page
@using SSP.Web.Pages
@model ListingsModel
@{
    ViewData["Title"] = "Listings";
}

<h1>Listings</h1>

@if (Model.Listings.Count == 0)
{
    <p class="text-muted">No listings found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th class="text-end">Price</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var listing in Model.Listings)
                {
                    <tr>
                        <td>@listing.Title</td>
                        <td>@listing.Description</td>
                        <td class="text-end">@listing.Price</td>
                        <td>@listing.CreatedAt.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
